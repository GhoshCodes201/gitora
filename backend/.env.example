# Gitora backend environment
GITORA_GITHUB_TOKEN=
GITORA_GITHUB_API_BASE=https://api.github.com
# Allow a non-GitHub GitHub API base (e.g. a local mock). Default: false.
GITORA_ALLOW_CUSTOM_GITHUB_API_BASE=false
# production | development — CSP hardening headers only apply in production.
GITORA_ENVIRONMENT=production
GITORA_REQUEST_BUDGET=45
GITORA_REPO_STATS_BUDGET=10
GITORA_PERSONAL_COMMITS_MAX_PAGES=3
GITORA_CACHE_TTL_HOURS=6
GITORA_DB_PATH=data/gitora.db
GITORA_CORS_ORIGINS=*
GITORA_API_RATE_LIMIT=10
GITORA_API_RATE_WINDOW_SECONDS=600
GITORA_API_GLOBAL_DAILY_LIMIT=200

# Gitora backend environment
GITORA_GITHUB_TOKEN=
GITORA_GITHUB_API_BASE=https://api.github.com
# Allow a non-GitHub GitHub API base (e.g. a local mock). Default: false.
GITORA_ALLOW_CUSTOM_GITHUB_API_BASE=false
# production | development — CSP hardening headers only apply in production.
GITORA_ENVIRONMENT=production
GITORA_REQUEST_BUDGET=45
GITORA_REPO_STATS_BUDGET=10
GITORA_PERSONAL_COMMITS_MAX_PAGES=3
GITORA_CACHE_TTL_HOURS=6
GITORA_DB_PATH=data/gitora.db
GITORA_CORS_ORIGINS=*
GITORA_API_RATE_LIMIT=10
GITORA_API_RATE_WINDOW_SECONDS=600
GITORA_API_GLOBAL_DAILY_LIMIT=200

# --- GitHub OAuth authentication (optional) ---
# Register a GitHub OAuth App: https://github.com/settings/developers
# Set GITORA_AUTH_REQUIRED=true to lock /analyze behind a GitHub login.
GITORA_AUTH_REQUIRED=false
GITORA_GITHUB_CLIENT_ID=
GITORA_GITHUB_CLIENT_SECRET=
# JWT signing secret. If empty, a per-process fallback is used (tokens do not
# survive a restart). Set a strong random value in production.
GITORA_AUTH_SECRET=
# Full callback URL, e.g. https://gitora.onrender.com/api/v1/auth/callback
GITORA_AUTH_REDIRECT_URI=
GITORA_AUTH_TOKEN_TTL_HOURS=72
